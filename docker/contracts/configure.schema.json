{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:padm:docker-configure:1",
  "title": "padm Docker configuration request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "core", "tls", "subscription", "images", "host_integrations"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest_sha256", "signature_identity"],
      "properties": {
        "version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_identity": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocols"],
      "properties": {
        "type": {
          "enum": ["xray", "sing-box"]
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/reality_protocol"
              },
              {
                "$ref": "#/$defs/websocket_protocol"
              }
            ]
          }
        }
      }
    },
    "tls": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain"],
          "properties": {
            "domain": {
              "$ref": "#/$defs/hostname"
            }
          }
        }
      ]
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "token"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xray", "sing-box", "nginx", "ops", "net"],
      "properties": {
        "xray": {
          "$ref": "#/$defs/image_reference"
        },
        "sing-box": {
          "$ref": "#/$defs/image_reference"
        },
        "nginx": {
          "$ref": "#/$defs/image_reference"
        },
        "ops": {
          "$ref": "#/$defs/image_reference"
        },
        "net": {
          "$ref": "#/$defs/image_reference"
        }
      }
    },
    "host_integrations": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/wireguard_integration"},
          {"$ref": "#/$defs/fail2ban_integration"},
          {"$ref": "#/$defs/tun_integration"},
          {"$ref": "#/$defs/tproxy_integration"}
        ]
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "address_families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["ipv4", "ipv6"]
      }
    },
    "account_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~@+=:-]{1,64}$"
    },
    "server_address": {
      "oneOf": [
        {
          "$ref": "#/$defs/hostname"
        },
        {
          "type": "string",
          "format": "ipv4"
        },
        {
          "type": "string",
          "format": "ipv6"
        }
      ]
    },
    "image_reference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/:@-]*:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"
    },
    "integration_base": {
      "type": "object",
      "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
      "properties": {
        "type": {"type": "string"},
        "profile": {"type": "string", "pattern": "^net-[a-z0-9][a-z0-9_-]*$"},
        "firewall_rules": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/safe_name"}},
        "devices": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/safe_name"}},
        "schedules": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/safe_name"}},
        "settings": {"type": "object"}
      }
    },
    "safe_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "wireguard_integration": {
      "allOf": [
        {"$ref": "#/$defs/integration_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
          "properties": {
            "type": {"const": "wireguard"},
            "profile": {"const": "net-wireguard"},
            "firewall_rules": {"const": []},
            "devices": {"const": ["wg-padm"]},
            "schedules": {"const": []},
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["config_file", "interface"],
              "properties": {
                "config_file": {"const": "wg-padm.conf"},
                "interface": {"const": "wg-padm"}
              }
            }
          }
        }
      ]
    },
    "fail2ban_integration": {
      "allOf": [
        {"$ref": "#/$defs/integration_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
          "properties": {
            "type": {"const": "fail2ban"},
            "profile": {"const": "net-fail2ban"},
            "firewall_rules": {"const": ["DOCKER-USER"]},
            "devices": {"const": []},
            "schedules": {"const": []},
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["log_file", "ports", "max_retry", "find_time", "ban_time"],
              "properties": {
                "log_file": {"const": "access.log"},
                "ports": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/port"}},
                "max_retry": {"type": "integer", "minimum": 1, "maximum": 20},
                "find_time": {"type": "integer", "minimum": 60, "maximum": 86400},
                "ban_time": {"type": "integer", "minimum": 60, "maximum": 604800}
              }
            }
          }
        }
      ]
    },
    "tun_integration": {
      "allOf": [
        {"$ref": "#/$defs/integration_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
          "properties": {
            "type": {"const": "tun"},
            "profile": {"const": "net-transparent"},
            "firewall_rules": {"const": ["sing-box-auto-redirect"]},
            "devices": {"const": ["/dev/net/tun"]},
            "schedules": {"const": []},
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["interface", "address"],
              "properties": {
                "interface": {"const": "padm-tun"},
                "address": {"const": "198.18.0.1/30"}
              }
            }
          }
        }
      ]
    },
    "tproxy_integration": {
      "allOf": [
        {"$ref": "#/$defs/integration_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
          "properties": {
            "type": {"const": "tproxy"},
            "profile": {"const": "net-transparent"},
            "firewall_rules": {"const": ["padm-tproxy"]},
            "devices": {"const": []},
            "schedules": {"const": []},
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port", "mark"],
              "properties": {
                "port": {"$ref": "#/$defs/port"},
                "mark": {"type": "integer", "minimum": 1, "maximum": 2147483647}
              }
            }
          }
        }
      ]
    },
    "protocol_base": {
      "type": "object",
      "required": ["id", "server", "public_port", "address_families", "name", "uuid"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "server": {
          "$ref": "#/$defs/server_address"
        },
        "public_port": {
          "$ref": "#/$defs/port"
        },
        "address_families": {
          "$ref": "#/$defs/address_families"
        },
        "name": {
          "$ref": "#/$defs/account_name"
        },
        "uuid": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "reality_protocol": {
      "allOf": [
        {
          "$ref": "#/$defs/protocol_base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "server", "public_port", "address_families", "name", "uuid", "reality"],
          "properties": {
            "id": {
              "const": 1
            },
            "server": {
              "$ref": "#/$defs/server_address"
            },
            "public_port": {
              "$ref": "#/$defs/port"
            },
            "address_families": {
              "$ref": "#/$defs/address_families"
            },
            "name": {
              "$ref": "#/$defs/account_name"
            },
            "uuid": {
              "$ref": "#/$defs/uuid"
            },
            "reality": {
              "type": "object",
              "additionalProperties": false,
              "required": ["server_name", "target_host", "target_port", "private_key", "public_key", "short_id"],
              "properties": {
                "server_name": {
                  "$ref": "#/$defs/hostname"
                },
                "target_host": {
                  "$ref": "#/$defs/hostname"
                },
                "target_port": {
                  "$ref": "#/$defs/port"
                },
                "private_key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "public_key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "short_id": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{2}){1,8}$"
                }
              }
            }
          }
        }
      ]
    },
    "websocket_protocol": {
      "allOf": [
        {
          "$ref": "#/$defs/protocol_base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "server", "public_port", "address_families", "name", "uuid", "websocket"],
          "properties": {
            "id": {
              "const": 21
            },
            "server": {
              "$ref": "#/$defs/server_address"
            },
            "public_port": {
              "$ref": "#/$defs/port"
            },
            "address_families": {
              "$ref": "#/$defs/address_families"
            },
            "name": {
              "$ref": "#/$defs/account_name"
            },
            "uuid": {
              "$ref": "#/$defs/uuid"
            },
            "websocket": {
              "type": "object",
              "additionalProperties": false,
              "required": ["domain", "path"],
              "properties": {
                "domain": {
                  "$ref": "#/$defs/hostname"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{8,64}$"
                }
              }
            }
          }
        }
      ]
    }
  }
}
