{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:padm:docker-configure:3",
  "title": "padm Docker configuration request",
  "type": "object",
  "x-padm-reality-stream-deployment": true,
  "x-padm-reality-stream-host-website": true,
  "x-padm-reality-stream-host-network": true,
  "x-padm-accounts": true,
  "x-padm-control-sync": true,
  "x-padm-control-state": true,
  "additionalProperties": false,
  "required": ["schema_version", "release", "core", "tls", "subscription", "images", "host_integrations"],
  "properties": {
    "schema_version": {
      "enum": [1, 2, 3]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "role", "node_id", "listen", "peer", "revision", "last_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "role": {"const": "main"},
        "node_id": {"$ref": "#/$defs/uuid"},
        "listen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interface", "address", "port"],
          "properties": {
            "interface": {"const": "wg-padm"},
            "address": {"type": "string", "format": "ipv4", "pattern": "^(10\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.)"},
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535}
          }
        },
        "peer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "address", "enabled", "expires_at", "token_sha256"],
          "properties": {
            "id": {"$ref": "#/$defs/uuid"},
            "address": {"type": "string", "format": "ipv4", "pattern": "^(10\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.)"},
            "enabled": {"type": "boolean"},
            "expires_at": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}
          }
        },
        "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "last_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}
      }
    },
    "control_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "role", "node_id", "controller_id", "listener_ids", "last_revision", "last_digest", "managed_accounts"],
      "properties": {
        "schema_version": {"const": 1},
        "role": {"const": "controlled"},
        "node_id": {"$ref": "#/$defs/uuid"},
        "controller_id": {"$ref": "#/$defs/uuid"},
        "listener_ids": {"$ref": "#/properties/accounts/items/properties/listeners"},
        "last_revision": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          ]
        },
        "last_digest": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}
          ]
        },
        "managed_accounts": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/properties/accounts/items"}
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "enabled", "uuid", "password", "shadowsocks_password", "listeners"],
        "properties": {
          "id": {"$ref": "#/$defs/uuid"},
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
          },
          "enabled": {"type": "boolean"},
          "uuid": {"$ref": "#/$defs/uuid"},
          "password": {"type": "string", "pattern": "^[A-Za-z0-9._~@+=:-]{16,128}(?![\\s\\S])"},
          "shadowsocks_password": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[A-Za-z0-9+/]{21}[AQgw]==(?![\\s\\S])"}
            ]
          },
          "listeners": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:entry-[a-z0-9][a-z0-9-]{0,47}|vless-reality|vless-ws)(?![\\s\\S])"
            }
          }
        }
      }
    },
    "reality_stream": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["listener_id"],
          "oneOf": [
            {"required": ["website_listener_id"]},
            {"required": ["host_website"]}
          ],
          "properties": {
            "listener_id": {
              "type": "string",
              "pattern": "^(?:entry-[a-z0-9][a-z0-9-]{0,47}|vless-reality)$"
            },
            "website_listener_id": {
              "type": "string",
              "pattern": "^(?:entry-[a-z0-9][a-z0-9-]{0,47}|vless-ws)$"
            },
            "host_website": {
              "type": "object",
              "additionalProperties": false,
              "required": ["domains", "address", "port"],
              "properties": {
                "domains": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "allOf": [
                      {"$ref": "#/$defs/hostname"},
                      {"pattern": "^[a-z0-9.-]+$"}
                    ]
                  }
                },
                "address": {
                  "type": "string",
                  "anyOf": [
                    {"enum": ["127.0.0.1", "::1"]},
                    {"const": "host.docker.internal"},
                    {
                      "format": "ipv4",
                      "pattern": "^(?!0\\.|127\\.|169\\.254\\.)(?:[1-9][0-9]?|1[0-9]{2}|2[01][0-9]|22[0-3])(?:\\.(?:0|[1-9][0-9]{0,2})){3}$"
                    },
                    {
                      "format": "ipv6",
                      "pattern": "^(?:[23][A-Fa-f0-9]{3}|[fF][cCdD][A-Fa-f0-9]{2}):[A-Fa-f0-9:]+$"
                    }
                  ]
                },
                "port": {
                  "allOf": [
                    {"$ref": "#/$defs/port"},
                    {"not": {"enum": [443, 15443]}}
                  ]
                },
                "network_mode": {"const": "host"}
              },
              "if": {"required": ["network_mode"]},
              "then": {"properties": {"address": {"enum": ["127.0.0.1", "::1"]}}},
              "else": {"properties": {"address": {"not": {"enum": ["127.0.0.1", "::1"]}}}}
            }
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest_sha256", "signature_identity"],
      "properties": {
        "version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_identity": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocols"],
      "properties": {
        "type": {
          "enum": ["xray", "sing-box"]
        },
        "secondary_type": {
          "enum": ["xray", "sing-box", null]
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/reality_protocol"
              },
              {
                "$ref": "#/$defs/xhttp_reality_protocol"
              },
              {
                "$ref": "#/$defs/grpc_reality_protocol"
              },
              {
                "$ref": "#/$defs/trojan_protocol"
              },
              {
                "$ref": "#/$defs/hysteria2_protocol"
              },
              {
                "$ref": "#/$defs/anytls_protocol"
              },
              {
                "$ref": "#/$defs/naive_protocol"
              },
              {
                "$ref": "#/$defs/shadowsocks_protocol"
              },
              {
                "$ref": "#/$defs/tuic_protocol"
              },
              {
                "$ref": "#/$defs/websocket_protocol"
              },
              {
                "$ref": "#/$defs/vmess_protocol"
              },
              {
                "$ref": "#/$defs/httpupgrade_protocol"
              },
              {
                "$ref": "#/$defs/grpc_tls_protocol"
              },
              {
                "$ref": "#/$defs/fallback_tls_protocol"
              }
            ]
          }
        }
      }
    },
    "tls": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain"],
          "properties": {
            "domain": {
              "$ref": "#/$defs/hostname"
            }
          }
        }
      ]
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "token"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xray", "sing-box", "nginx", "ops", "net"],
      "properties": {
        "xray": {
          "$ref": "#/$defs/image_reference"
        },
        "sing-box": {
          "$ref": "#/$defs/image_reference"
        },
        "nginx": {
          "$ref": "#/$defs/image_reference"
        },
        "ops": {
          "$ref": "#/$defs/image_reference"
        },
        "net": {
          "$ref": "#/$defs/image_reference"
        }
      }
    },
    "host_integrations": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/wireguard_integration"},
          {"$ref": "#/$defs/fail2ban_integration"},
          {"$ref": "#/$defs/tun_integration"},
          {"$ref": "#/$defs/tproxy_integration"}
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["control"]},
      "then": {
        "not": {"required": ["control_sync"]},
        "properties": {
          "schema_version": {"const": 3},
          "host_integrations": {"contains": {"properties": {"type": {"const": "wireguard"}}, "required": ["type"]}},
          "control": {
            "if": {"properties": {"last_digest": {"type": "null"}}},
            "then": {"properties": {"revision": {"const": 0}}}
          }
        }
      }
    },
    {
      "if": {"required": ["control_sync"]},
      "then": {"properties": {"schema_version": {"const": 3}}}
    },
    {
      "if": {"required": ["accounts"]},
      "then": {"properties": {"schema_version": {"const": 3}}}
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 1}}
      },
      "then": {
        "properties": {
          "core": {
            "properties": {
              "protocols": {
                "maxItems": 2,
                "items": {
                  "not": {"required": ["listener_id"]},
                  "properties": {
                    "websocket": {
                      "not": {
                        "anyOf": [
                          {"required": ["backend_port"]},
                          {"required": ["tls_port"]}
                        ]
                      }
                    }
                  }
                },
                "allOf": [
                  {
                    "contains": {"properties": {"id": {"const": 1}}},
                    "minContains": 0,
                    "maxContains": 1
                  },
                  {
                    "contains": {"properties": {"id": {"const": 21}}},
                    "minContains": 0,
                    "maxContains": 1
                  }
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "core": {
            "properties": {
              "protocols": {
                "items": {
                  "required": ["listener_id"],
                  "properties": {
                    "websocket": {
                      "required": ["backend_port", "tls_port"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"enum": [1, 2]}}
      },
      "then": {
        "not": {"required": ["reality_stream"]},
        "properties": {
          "core": {
            "not": {"required": ["secondary_type"]},
            "properties": {
              "protocols": {
                "items": {
                  "not": {"required": ["core"]},
                  "properties": {"id": {"enum": [1, 21]}}
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "core": {
            "required": ["secondary_type"],
            "properties": {
              "protocols": {
                "items": {
                  "required": ["core"],
                  "if": {"properties": {"id": {"enum": [21, 22, 24, 25, 27, 29]}}},
                  "then": {"properties": {"core": {"const": "xray"}}}
                }
              }
            },
            "allOf": [
              {
                "if": {"properties": {"type": {"const": "xray"}}},
                "then": {
                  "properties": {
                    "secondary_type": {"enum": ["sing-box", null]},
                    "protocols": {
                      "contains": {"properties": {"core": {"const": "xray"}}}
                    }
                  }
                },
                "else": {
                  "properties": {
                    "secondary_type": {"enum": ["xray", null]},
                    "protocols": {
                      "contains": {"properties": {"core": {"const": "sing-box"}}}
                    }
                  }
                }
              },
              {
                "if": {"properties": {"secondary_type": {"const": null}}},
                "then": {
                  "if": {"properties": {"type": {"const": "xray"}}},
                  "then": {
                    "properties": {
                      "protocols": {"items": {"properties": {"core": {"const": "xray"}}}}
                    }
                  },
                  "else": {
                    "properties": {
                      "protocols": {"items": {"properties": {"core": {"const": "sing-box"}}}}
                    }
                  }
                },
                "else": {
                  "properties": {
                    "protocols": {
                      "allOf": [
                        {"contains": {"properties": {"core": {"const": "xray"}}}},
                        {"contains": {"properties": {"core": {"const": "sing-box"}}}}
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "if": {
          "properties": {
            "core": {"properties": {"secondary_type": {"type": "string"}}}
          }
        },
        "then": {"properties": {"host_integrations": {"const": []}}}
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"enum": [1, 2]},
          "core": {
            "properties": {"type": {"const": "sing-box"}}
          }
        }
      },
      "then": {
        "properties": {
          "core": {
            "properties": {
              "protocols": {
                "items": {"properties": {"id": {"const": 1}}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "core": {
            "properties": {
              "protocols": {"contains": {"properties": {"id": {"enum": [3, 4, 5, 21, 22, 23, 24, 25, 27, 28, 29, 31]}}}}
            }
          }
        }
      },
      "then": {"properties": {"tls": {"type": "object"}}},
      "else": {
        "properties": {
          "tls": {"const": null},
          "subscription": {"properties": {"enabled": {"const": false}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "subscription": {"properties": {"enabled": {"const": true}}}
        }
      },
      "then": {
        "properties": {
          "core": {
            "properties": {
              "protocols": {"contains": {"properties": {"id": {"const": 21}}}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "core": {
            "properties": {
              "protocols": {"contains": {"properties": {"id": {"enum": [3, 4, 5, 22, 23, 24, 25, 27, 28, 29, 30, 31]}}}}
            }
          }
        }
      },
      "then": {"properties": {"host_integrations": {"const": []}}}
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?=.{1,253}(?![\\s\\S]))(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}(?![\\s\\S])"
    },
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "address_families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["ipv4", "ipv6"]
      }
    },
    "account_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._~@+=:-]{1,64}(?![\\s\\S])"
    },
    "server_address": {
      "oneOf": [
        {
          "$ref": "#/$defs/hostname"
        },
        {
          "type": "string",
          "format": "ipv4"
        },
        {
          "type": "string",
          "format": "ipv6"
        }
      ]
    },
    "image_reference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/:@-]*:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"
    },
    "integration_base": {
      "type": "object",
      "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
      "properties": {
        "type": {"type": "string"},
        "profile": {"type": "string", "pattern": "^net-[a-z0-9][a-z0-9_-]*$"},
        "firewall_rules": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/safe_name"}},
        "devices": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/safe_name"}},
        "schedules": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/safe_name"}},
        "settings": {"type": "object"}
      }
    },
    "safe_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "wireguard_integration": {
      "allOf": [
        {"$ref": "#/$defs/integration_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
          "properties": {
            "type": {"const": "wireguard"},
            "profile": {"const": "net-wireguard"},
            "firewall_rules": {"const": []},
            "devices": {"const": ["wg-padm"]},
            "schedules": {"const": []},
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["config_file", "interface"],
              "properties": {
                "config_file": {"const": "wg-padm.conf"},
                "interface": {"const": "wg-padm"}
              }
            }
          }
        }
      ]
    },
    "fail2ban_integration": {
      "allOf": [
        {"$ref": "#/$defs/integration_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
          "properties": {
            "type": {"const": "fail2ban"},
            "profile": {"const": "net-fail2ban"},
            "firewall_rules": {"const": ["DOCKER-USER"]},
            "devices": {"const": []},
            "schedules": {"const": []},
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["log_file", "ports", "max_retry", "find_time", "ban_time"],
              "properties": {
                "log_file": {"const": "access.log"},
                "ports": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/port"}},
                "max_retry": {"type": "integer", "minimum": 1, "maximum": 20},
                "find_time": {"type": "integer", "minimum": 60, "maximum": 86400},
                "ban_time": {"type": "integer", "minimum": 60, "maximum": 604800}
              }
            }
          }
        }
      ]
    },
    "tun_integration": {
      "allOf": [
        {"$ref": "#/$defs/integration_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
          "properties": {
            "type": {"const": "tun"},
            "profile": {"const": "net-transparent"},
            "firewall_rules": {"const": ["sing-box-auto-redirect"]},
            "devices": {"const": ["/dev/net/tun"]},
            "schedules": {"const": []},
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["interface", "address"],
              "properties": {
                "interface": {"const": "padm-tun"},
                "address": {"const": "198.18.0.1/30"}
              }
            }
          }
        }
      ]
    },
    "tproxy_integration": {
      "allOf": [
        {"$ref": "#/$defs/integration_base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
          "properties": {
            "type": {"const": "tproxy"},
            "profile": {"const": "net-transparent"},
            "firewall_rules": {"const": ["padm-tproxy"]},
            "devices": {"const": []},
            "schedules": {"const": []},
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port", "mark"],
              "properties": {
                "port": {"$ref": "#/$defs/port"},
                "mark": {"type": "integer", "minimum": 1, "maximum": 2147483647}
              }
            }
          }
        }
      ]
    },
    "protocol_base": {
      "type": "object",
      "required": ["id", "server", "public_port", "address_families", "name", "uuid"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "server": {
          "$ref": "#/$defs/server_address"
        },
        "public_port": {
          "$ref": "#/$defs/port"
        },
        "address_families": {
          "$ref": "#/$defs/address_families"
        },
        "name": {
          "$ref": "#/$defs/account_name"
        },
        "uuid": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "reality_protocol": {
      "allOf": [
        {
          "$ref": "#/$defs/protocol_base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "server", "public_port", "address_families", "name", "uuid", "reality"],
          "properties": {
            "id": {
              "const": 1
            },
            "listener_id": {
              "type": "string",
              "pattern": "^(?:entry-[a-z0-9][a-z0-9-]{0,47}|vless-reality)(?![\\s\\S])"
            },
