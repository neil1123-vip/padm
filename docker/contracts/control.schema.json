{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "padm Docker private control state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "node_id", "listen", "peer", "revision", "accounts"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "main"},
    "node_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "address", "port"],
      "properties": {
        "interface": {"const": "wg-padm"},
        "address": {"$ref": "#/$defs/private_address"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535}
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "address", "enabled", "expires_at", "token_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "address": {"$ref": "#/$defs/private_address"},
        "enabled": {"type": "boolean"},
        "expires_at": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}
      }
    },
    "accounts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "enabled", "uuid", "password", "shadowsocks_password"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
          "enabled": {"type": "boolean"},
          "uuid": {"$ref": "#/$defs/id"},
          "password": {"type": "string", "pattern": "^[A-Za-z0-9._~@+=:-]{16,128}(?![\\s\\S])"},
          "shadowsocks_password": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9+/]{21}[AQgw]==(?![\\s\\S])"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"},
    "private_address": {"type": "string", "format": "ipv4", "pattern": "^(10\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.)"}
  }
}
