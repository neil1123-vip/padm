{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:padm:deployment:1",
  "title": "padm Docker deployment state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "padm_version",
    "bundle_version",
    "manifest",
    "compose",
    "core",
    "listeners",
    "images",
    "formats",
    "previous_manifest_sha256",
    "host_integrations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "const": "docker"
    },
    "padm_version": {
      "$ref": "#/$defs/non_empty_string"
    },
    "bundle_version": {
      "$ref": "#/$defs/non_empty_string"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "signature_identity"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_identity": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "profiles"],
      "properties": {
        "project": {
          "const": "padm-docker"
        },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_ids"],
      "properties": {
        "type": {
          "enum": ["xray", "sing-box"]
        },
        "protocol_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "listeners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "public_port",
          "container_port",
          "transport",
          "address_families"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "public_port": {
            "$ref": "#/$defs/port"
          },
          "container_port": {
            "$ref": "#/$defs/port"
          },
          "transport": {
            "enum": ["tcp", "udp"]
          },
          "address_families": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["ipv4", "ipv6"]
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xray", "sing-box", "nginx", "ops", "net"],
      "properties": {
        "xray": {
          "$ref": "#/$defs/image"
        },
        "sing-box": {
          "$ref": "#/$defs/image"
        },
        "nginx": {
          "$ref": "#/$defs/image"
        },
        "ops": {
          "$ref": "#/$defs/image"
        },
        "net": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compose", "config", "data"],
      "properties": {
        "compose": {
          "$ref": "#/$defs/positive_integer"
        },
        "config": {
          "$ref": "#/$defs/positive_integer"
        },
        "data": {
          "$ref": "#/$defs/positive_integer"
        }
      }
    },
    "previous_manifest_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "host_integrations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "profile", "firewall_rules", "devices", "schedules"],
        "properties": {
          "type": {
            "enum": ["fail2ban", "wireguard", "port-hopping", "tun", "tproxy"]
          },
          "profile": {
            "type": "string",
            "pattern": "^net-[a-z0-9][a-z0-9_-]*$"
          },
          "firewall_rules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "devices": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "schedules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/non_empty_string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_digest"],
      "properties": {
        "index_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      }
    }
  }
}
