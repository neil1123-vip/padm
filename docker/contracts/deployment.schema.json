{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:padm:deployment:1",
  "title": "padm Docker deployment state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "padm_version",
    "bundle_version",
    "manifest",
    "compose",
    "core",
    "listeners",
    "images",
    "formats",
    "previous_manifest_sha256",
    "host_integrations"
  ],
  "properties": {
    "port_hopping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listener_id", "range_start", "range_end", "ipv4", "ipv6"],
      "properties": {
        "listener_id": {"type": "string", "pattern": "^entry-[a-z0-9][a-z0-9-]{0,47}$"},
        "range_start": {"$ref": "#/$defs/port"},
        "range_end": {"$ref": "#/$defs/port"},
        "ipv4": {"type": "string", "format": "ipv4"},
        "ipv6": {"type": "string", "format": "ipv6"}
      }
    },
    "schema_version": {
      "const": 1
    },
    "mode": {
      "const": "docker"
    },
    "padm_version": {
      "$ref": "#/$defs/non_empty_string"
    },
    "bundle_version": {
      "$ref": "#/$defs/non_empty_string"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "signature_identity"],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature_identity": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "profiles"],
      "properties": {
        "project": {
          "const": "padm-docker"
        },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_ids"],
      "properties": {
        "type": {
          "enum": ["xray", "sing-box"]
        },
        "secondary_type": {
          "enum": ["xray", "sing-box", null]
        },
        "protocol_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "listeners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "public_port",
          "container_port",
          "transport",
          "address_families"
        ],
        "properties": {
          "listener_id": {
            "type": "string",
            "pattern": "^(?:entry-[a-z0-9][a-z0-9-]{0,47}|vless-(?:reality|ws)|alias-[1-9][0-9]{0,4}-(?:tcp|udp)|relay-http|host-(?:acme-http|control|wireguard|tproxy-(?:tcp|udp)))$"
          },
          "target_listener_id": {
            "type": "string",
            "pattern": "^(?:entry-[a-z0-9][a-z0-9-]{0,47}|vless-(?:reality|ws))$"
          },
          "service": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "public_port": {
            "$ref": "#/$defs/port"
          },
          "container_port": {
            "$ref": "#/$defs/port"
          },
          "transport": {
            "enum": ["tcp", "udp"]
          },
          "address_families": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["ipv4", "ipv6"]
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xray", "sing-box", "nginx", "ops", "net"],
      "properties": {
        "xray": {
          "$ref": "#/$defs/image"
        },
        "sing-box": {
          "$ref": "#/$defs/image"
        },
        "nginx": {
          "$ref": "#/$defs/image"
        },
        "ops": {
          "$ref": "#/$defs/image"
        },
        "net": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compose", "config", "data"],
      "properties": {
        "compose": {
          "$ref": "#/$defs/positive_integer"
        },
        "config": {
          "$ref": "#/$defs/positive_integer"
        },
        "data": {
          "$ref": "#/$defs/positive_integer"
        }
      }
    },
    "previous_manifest_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "host_integrations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "profile", "firewall_rules", "devices", "schedules", "settings"],
        "properties": {
          "type": {
            "enum": ["fail2ban", "fail2ban-control", "fail2ban-ssh", "wireguard", "tun", "tproxy"]
          },
          "profile": {
            "type": "string",
            "pattern": "^net-[a-z0-9][a-z0-9_-]*$"
          },
          "firewall_rules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "devices": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "schedules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/non_empty_string"
            }
          },
          "settings": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "host_integrations": {
            "contains": {"properties": {"type": {"const": "fail2ban-ssh"}}, "required": ["type"]}
          }
        }
      },
      "then": {
        "properties": {
          "host_integrations": {
            "not": {
              "contains": {"properties": {"type": {"const": "fail2ban-control"}}, "required": ["type"]}
            },
            "items": {
              "if": {"properties": {"type": {"const": "fail2ban-ssh"}}},
              "then": {"$ref": "#/$defs/fail2ban_ssh_integration"}
            }
          },
          "compose": {"properties": {"profiles": {"contains": {"const": "net-fail2ban-ssh"}}}}
        }
      }
    },
    {
      "properties": {
        "listeners": {
          "items": {
            "if": {"required": ["listener_id"], "properties": {"listener_id": {"pattern": "^alias-"}}},
            "then": {"required": ["target_listener_id"]},
            "else": {"not": {"required": ["target_listener_id"]}}
          }
        }
      }
    },
    {
      "properties": {
        "listeners": {
          "items": {
            "if": {"required": ["listener_id"], "properties": {"listener_id": {"const": "relay-http"}}},
            "then": {
              "properties": {
                "service": {"const": "xray"},
                "transport": {"const": "tcp"}
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "listeners": {
          "items": {
            "if": {"required": ["listener_id"], "properties": {"listener_id": {"const": "host-acme-http"}}},
            "then": {
              "properties": {
                "service": {"const": "nginx"},
                "public_port": {"const": 80},
                "container_port": {"const": 8088},
                "transport": {"const": "tcp"},
                "address_families": {"const": ["ipv4", "ipv6"]}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "core": {
            "required": ["secondary_type"],
            "properties": {"secondary_type": {"type": "string"}}
          }
        }
      },
      "then": {
        "properties": {
          "host_integrations": {"const": []},
          "compose": {
            "properties": {
              "profiles": {
                "allOf": [
                  {"contains": {"const": "core-xray"}},
                  {"contains": {"const": "core-sing-box"}}
                ]
              }
            }
          },
          "core": {
            "if": {"properties": {"type": {"const": "xray"}}},
            "then": {"properties": {"secondary_type": {"const": "sing-box"}}},
            "else": {"properties": {"secondary_type": {"const": "xray"}}}
          }
        }
      }
    }
  ],
  "$defs": {
    "fail2ban_ssh_integration": {
      "properties": {
        "profile": {"const": "net-fail2ban-ssh"},
        "firewall_rules": {"const": ["INPUT"]},
        "devices": {"const": []},
        "schedules": {"const": []},
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "target", "port", "max_retry", "find_time", "ban_time"],
          "properties": {
            "unit": {"type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]*\\.service$"},
            "target": {
              "anyOf": [
                {"type": "string", "format": "ipv4"},
                {"type": "string", "format": "ipv6"}
              ]
            },
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "max_retry": {"type": "integer", "minimum": 1, "maximum": 20},
            "find_time": {"type": "integer", "minimum": 60, "maximum": 86400},
            "ban_time": {"type": "integer", "minimum": 60, "maximum": 604800}
          }
        }
      }
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_digest"],
      "properties": {
        "index_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      }
    }
  }
}
