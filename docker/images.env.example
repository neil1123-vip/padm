# CI replaces VERSION and DIGEST from the signed release manifest.
PADM_XRAY_IMAGE=ghcr.io/neil1123-vip/padm-xray:VERSION@sha256:DIGEST
PADM_SINGBOX_IMAGE=ghcr.io/neil1123-vip/padm-sing-box:VERSION@sha256:DIGEST
PADM_NGINX_IMAGE=ghcr.io/neil1123-vip/padm-nginx:VERSION@sha256:DIGEST
PADM_OPS_IMAGE=ghcr.io/neil1123-vip/padm-ops:VERSION@sha256:DIGEST
PADM_NET_IMAGE=ghcr.io/neil1123-vip/padm-net:VERSION@sha256:DIGEST
PADM_DOCKER_ROOT=/etc/padm-docker
